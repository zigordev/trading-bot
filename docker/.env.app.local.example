MARKET_DATA_TRADES_TOPIC=trading-bot.market-data.trades.v1
MARKET_DATA_BOOK_TICKERS_TOPIC=trading-bot.market-data.book-tickers.v1
STRATEGY_SIGNALS_TOPIC=trading-bot.strategy-engine.signals.v1

#CONTROL-PLANE
CONTROL_PLANE_REQUEST_TIMEOUT_MS=5000

#MARKET-DATA
RUNTIME_CONFIG_REFRESH_INTERVAL_MS=30000
CONFIG_REFRESH_DEBOUNCE_MS=500
READINESS_MAX_CONFIG_AGE_MS=120000
BINANCE_STREAM_BASE_URL=wss://stream.binance.com:9443/stream
BINANCE_REST_BASE_URL=https://api.binance.com
BINANCE_RECONNECT_BACKOFF_MS=2000
BINANCE_REST_MAX_RETRIES=5
BINANCE_REST_RETRY_BACKOFF_MS=500
HISTORICAL_BACKFILL_LIMIT=500
HISTORICAL_TRADE_BACKFILL_LIMIT=1000
HISTORICAL_TRADE_BACKFILL_MAX_BATCHES=100
HISTORICAL_BOOK_TICKER_BACKFILL_INTERVAL_MS=60000
HISTORICAL_BACKFILL_MAX_CONCURRENCY=4
HISTORICAL_KLINE_RETENTION_DAYS=365
HISTORICAL_TRADE_RETENTION_DAYS=90
HISTORICAL_BOOK_TICKER_RETENTION_DAYS=30
HISTORICAL_TRADE_BACKFILL_INSERT_BATCH_ROWS=50000
HISTORICAL_TRADE_BACKFILL_CHUNK_MS=86400000
HISTORICAL_KLINE_BACKFILL_INSERT_BATCH_ROWS=50000
READINESS_MAX_DEPENDENCY_AGE_MS=120000
BACKTEST_WARMUP_MULTIPLIER=5
BACKTEST_MAX_KLINES=100000
BACKTEST_MAX_TRADES=1000000
BACKTEST_MAX_BOOK_TICKERS=1000000
BACKTEST_RESULT_RETENTION_DAYS=365
BACKTEST_FEE_BPS=0
BACKTEST_SLIPPAGE_BPS=0
BACKTEST_TRADE_COVERAGE_TOLERANCE_MS=5000
AUTO_BACKTEST_ENABLED=false
AUTO_BACKTEST_INTERVAL_SECONDS=3600
AUTO_BACKTEST_RESEARCH_SETTINGS_NAME=default
AUTO_BACKTEST_WINDOW_KIND=backtesting
