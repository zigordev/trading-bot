#RUNTIME
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318/v1/traces

#DATABASE
POSTGRES_PASSWORD=SET_FROM_OPEN_BAO

#HISTORICAL-STORE
HISTORICAL_STORE_HOST=trading-bot-historical-store
HISTORICAL_STORE_PORT=8123
HISTORICAL_STORE_DATABASE=trading_bot_market_data
HISTORICAL_STORE_USER=trading_bot_market_data
HISTORICAL_STORE_PASSWORD=trading_bot_market_data

#KAFKA
KAFKA_BOOTSTRAP_SERVERS=platform-redpanda:9092
CONFIG_CHANGE_EVENTS_TOPIC=trading-bot.control-plane.config-changes.v1
