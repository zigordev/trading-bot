#RUNTIME
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318/v1/traces

#DATABASE
POSTGRES_PASSWORD=SET_FROM_OPEN_BAO

#HISTORICAL-STORE
HISTORICAL_STORE_HOST=trading-bot-historical-store
HISTORICAL_STORE_PORT=8123
HISTORICAL_STORE_NATIVE_PORT=9000
HISTORICAL_STORE_DATABASE=trading_bot_market_data
HISTORICAL_STORE_USER=trading_bot_market_data
HISTORICAL_STORE_PASSWORD=trading_bot_market_data

#KAFKA
KAFKA_BOOTSTRAP_SERVERS=platform-redpanda:9092
CONFIG_CHANGE_EVENTS_TOPIC=trading-bot.control-plane.config-changes.v1
MARKET_DATA_KLINES_TOPIC=trading-bot.market-data.klines.v1
MARKET_DATA_TRADES_TOPIC=trading-bot.market-data.trades.v1
MARKET_DATA_BOOK_TICKERS_TOPIC=trading-bot.market-data.book-tickers.v1
STRATEGY_SIGNALS_TOPIC=trading-bot.strategy-engine.signals.v1

#CONTROL-PLANE
CONTROL_PLANE_REQUEST_TIMEOUT_MS=5000

#MARKET-DATA
RUNTIME_CONFIG_REFRESH_INTERVAL_MS=30000
CONFIG_REFRESH_DEBOUNCE_MS=500
READINESS_MAX_CONFIG_AGE_MS=120000
TRADE_GAP_REPAIR_ENABLED=true
TRADE_GAP_REPAIR_INTERVAL_MS=3600000
TRADE_GAP_REPAIR_END_GRACE_MS=300000
TRADE_GAP_REPAIR_STARTUP_MAX_WINDOW_MS=15552000000
TRADE_GAP_REPAIR_PERIODIC_LOOKBACK_MS=604800000
TRADE_GAP_REPAIR_MAX_BATCHES_MULTIPLIER=1
BINANCE_STREAM_BASE_URL=wss://stream.binance.com:9443/stream
BINANCE_REST_BASE_URL=https://api.binance.com
BINANCE_RECONNECT_BACKOFF_MS=2000
BINANCE_REST_MAX_RETRIES=5
BINANCE_REST_RETRY_BACKOFF_MS=500
HISTORICAL_BACKFILL_LIMIT=500
HISTORICAL_TRADE_BACKFILL_LIMIT=1000
HISTORICAL_TRADE_BACKFILL_MAX_BATCHES=100
HISTORICAL_BOOK_TICKER_BACKFILL_INTERVAL_MS=60000
HISTORICAL_BACKFILL_MAX_CONCURRENCY=4
HISTORICAL_TRADE_BACKFILL_PAIR_MAX_CONCURRENCY=8
# Optional OOM guard: caps (HISTORICAL_BACKFILL_MAX_CONCURRENCY × HISTORICAL_TRADE_BACKFILL_INSERT_BATCH_ROWS).
# Omit entirely to honor full concurrency with very large insert batches (e.g. 3_000_000).
# HISTORICAL_BACKFILL_MAX_IN_FLIGHT_TRADE_ROWS=500000
HISTORICAL_KLINE_RETENTION_DAYS=365
HISTORICAL_TRADE_RETENTION_DAYS=90
HISTORICAL_BOOK_TICKER_RETENTION_DAYS=30
# Binance aggTrades page size is still capped at 1000 (HISTORICAL_TRADE_BACKFILL_LIMIT); this value
# is how many rows to buffer before each ClickHouse INSERT (can be millions).
HISTORICAL_TRADE_BACKFILL_INSERT_BATCH_ROWS=50000
HISTORICAL_TRADE_BACKFILL_USE_ROW_BINARY_INSERT=true
HISTORICAL_TRADE_BACKFILL_CHUNK_MS=86400000
HISTORICAL_KLINE_BACKFILL_INSERT_BATCH_ROWS=50000
READINESS_MAX_DEPENDENCY_AGE_MS=120000
BACKTEST_WARMUP_MULTIPLIER=5
BACKTEST_MAX_KLINES=100000
BACKTEST_MAX_TRADES=1000000
BACKTEST_MAX_BOOK_TICKERS=1000000
BACKTEST_TRADE_REPLAY_PAGE_MS=3600000
BACKTEST_TRADE_REPLAY_PAGE_ROWS=200000
BACKTEST_RESULT_RETENTION_DAYS=365
BACKTEST_FEE_BPS=0
BACKTEST_SLIPPAGE_BPS=0
BACKTEST_TRADE_COVERAGE_TOLERANCE_MS=5000
AUTO_BACKTEST_ENABLED=false
AUTO_BACKTEST_INTERVAL_SECONDS=3600
BACKTEST_TIMERANGE_MS_BY_TIMEFRAME=1m=600000000,3m=1800000000,5m=3000000000
MARKET_EVENT_DEDUP_CAPACITY=10000

#STRATEGY-ENGINE
MARKET_DATA_REQUEST_TIMEOUT_MS=5000
STRATEGY_WARMUP_HISTORY_LIMIT=250

#OPENBAO
OPENBAO_TOKEN=CHANGE_ME_LOCAL_OPENBAO_TOKEN
