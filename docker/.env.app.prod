#RUNTIME
LOG_LEVEL=info

#DATABASE
POSTGRES_PASSWORD=SET_FROM_OPEN_BAO

#HISTORICAL-STORE
HISTORICAL_STORE_DATABASE=trading_bot_market_data
HISTORICAL_STORE_USER=trading_bot_market_data
HISTORICAL_STORE_PASSWORD=SET_FROM_OPEN_BAO

#KAFKA
KAFKA_BOOTSTRAP_SERVERS=platform-redpanda:9092
CONFIG_CHANGE_EVENTS_TOPIC=trading-bot.control-plane.config-changes.v1
DATA_READINESS_EVENTS_TOPIC=trading-bot.market-data.data-readiness-snapshot.v1
MARKET_DATA_KLINE_EVENTS_TOPIC=trading-bot.market-data.kline.v1
MARKET_DATA_TRADE_EVENTS_TOPIC=trading-bot.market-data.agg-trade.v1
BACKTEST_COMPLETED_EVENTS_TOPIC=trading-bot.research-backtesting.backtest-completed.v1
BACKTEST_PROGRESS_EVENTS_TOPIC=trading-bot.research-backtesting.backtest-progress.v1

#CONTROL-PLANE
CONTROL_PLANE_REQUEST_TIMEOUT_MS=5000
UPSTREAM_REQUEST_TIMEOUT_MS=30000

#MARKET-DATA
CONFIG_REFRESH_DEBOUNCE_MS=500
READINESS_MAX_CONFIG_AGE_MS=120000
BINANCE_REST_BASE_URL=https://api.binance.com
BINANCE_WS_BASE_URL=wss://stream.binance.com:9443
HISTORICAL_KLINE_RETENTION_DAYS=120
HISTORICAL_TRADE_RETENTION_DAYS=90
HISTORICAL_STORE_COMPACTION_ENABLED=true
HISTORICAL_BACKFILL_MAX_CONCURRENCY=4
HISTORICAL_TRADE_BACKFILL_PAIR_MAX_CONCURRENCY=8

#RESEARCH-BACKTESTING
SCHEDULED_BACKTESTS_ENABLED=false
SCHEDULED_BACKTESTS_INTERVAL_SECONDS=3600
READINESS_MAX_DEPENDENCY_AGE_MS=120000

#EXECUTION
EXECUTION_DEFAULT_MODE=paper
EXECUTION_DEFAULT_POSITION_NOTIONAL_USD=100

#OPENBAO
OPENBAO_TOKEN=CHANGE_ME_PROD_OPENBAO_APP_READ_TOKEN

#CONSOLE_BUILD
NEXT_PUBLIC_CONTROL_PLANE_BASE_URL=https://trading-bot-api.zigordev.com
NEXT_PUBLIC_RELEASE=bootstrap

#DEPLOY_IMAGES
CONTROL_PLANE_IMAGE=REQUIRED_SET_BY_DEPLOY
OPERATOR_CONSOLE_IMAGE=REQUIRED_SET_BY_DEPLOY
MARKET_DATA_IMAGE=REQUIRED_SET_BY_DEPLOY
RESEARCH_BACKTESTING_IMAGE=REQUIRED_SET_BY_DEPLOY
EXECUTION_IMAGE=REQUIRED_SET_BY_DEPLOY
