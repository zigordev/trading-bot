{
  "release-type": "node",
  "packages": {
    ".": {
      "release-type": "node"
    }
  },
  "include-v-in-tag": true,
  "include-component-in-tag": false,
  "bump-minor-pre-major": true,
  "bump-patch-for-minor-pre-major": true,
  "changelog-path": "CHANGELOG.md",
  "extra-files": [
    "apps/control-plane/package.json",
    "apps/operator-console/package.json",
    {
      "type": "toml",
      "path": "Cargo.toml",
      "jsonpath": "$.workspace.package.version"
    },
    {
      "type": "json",
      "path": "package-lock.json",
      "jsonpath": "$.packages['apps/control-plane'].version"
    },
    {
      "type": "json",
      "path": "package-lock.json",
      "jsonpath": "$.packages['apps/operator-console'].version"
    },
    {
      "type": "toml",
      "path": "Cargo.lock",
      "jsonpath": "$.package[?(@.name.value=='trading-bot-execution')].version"
    },
    {
      "type": "toml",
      "path": "Cargo.lock",
      "jsonpath": "$.package[?(@.name.value=='trading-bot-market-data')].version"
    },
    {
      "type": "toml",
      "path": "Cargo.lock",
      "jsonpath": "$.package[?(@.name.value=='trading-bot-observability')].version"
    },
    {
      "type": "toml",
      "path": "Cargo.lock",
      "jsonpath": "$.package[?(@.name.value=='trading-bot-research-backtesting')].version"
    },
    {
      "type": "toml",
      "path": "Cargo.lock",
      "jsonpath": "$.package[?(@.name.value=='trading-bot-strategy-engine')].version"
    }
  ]
}
